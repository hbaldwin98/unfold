{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unfold",
  "version": "0.3.0",
  "identifier": "com.workedexamples.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unfold",
        "width": 680,
        "height": 860,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic"],
          "color": "#00000099"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; font-src 'self' asset:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
